	ColorSequenceKeypoint.new(0, Color3.fromRGB(7, 7, 15)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(18, 10, 32)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 10, 25))
})
