local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KnoxLoadingUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- Background
local background = Instance.new("Frame")
background.Size = UDim2.fromScale(1, 1)
background.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
background.BorderSizePixel = 0
background.Parent = gui

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.fromScale(0.8, 0.12)
title.Position = UDim2.fromScale(0.1, 0.32)
title.BackgroundTransparency = 1
title.Text = "Knox Script Loading Script"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = background

-- Percentage
local percent = Instance.new("TextLabel")
percent.Size = UDim2.fromScale(0.6, 0.06)
percent.Position = UDim2.fromScale(0.2, 0.47)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.TextColor3 = Color3.new(1, 1, 1)
percent.TextScaled = true
percent.Font = Enum.Font.Gotham
percent.Parent = background

-- Bar Background
local barBackground = Instance.new("Frame")
barBackground.Size = UDim2.fromScale(0.6, 0.025)
barBackground.Position = UDim2.fromScale(0.2, 0.56)
barBackground.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
barBackground.BorderSizePixel = 0
barBackground.Parent = background

-- Loading Bar
local bar = Instance.new("Frame")
bar.Size = UDim2.fromScale(0, 1)
bar.BackgroundColor3 = Color3.new(1, 1, 1)
bar.BorderSizePixel = 0
bar.Parent = barBackground

-- 1% - 70% MEDIUM FAST
for i = 1, 70 do
    percent.Text = i .. "%"

    TweenService:Create(
        bar,
        TweenInfo.new(0.045, Enum.EasingStyle.Linear),
        {Size = UDim2.fromScale(i / 100, 1)}
    ):Play()

    task.wait(0.045)
end

-- 71% - 74% TRANSITION
for i = 71, 74 do
    percent.Text = i .. "%"

    TweenService:Create(
        bar,
        TweenInfo.new(0.12, Enum.EasingStyle.Linear),
        {Size = UDim2.fromScale(i / 100, 1)}
    ):Play()

    task.wait(0.12)
end

-- 75% - 100% VERY SLOW
for i = 75, 100 do
    percent.Text = i .. "%"

    TweenService:Create(
        bar,
        TweenInfo.new(0.35, Enum.EasingStyle.Linear),
        {Size = UDim2.fromScale(i / 100, 1)}
    ):Play()

    task.wait(0.35)
end

percent.Text = "100%"

task.wait(0.5)

-- FADE OUT
local fadeInfo = TweenInfo.new(
    0.7,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
)

TweenService:Create(background, fadeInfo, {
    BackgroundTransparency = 1
}):Play()

TweenService:Create(title, fadeInfo, {
    TextTransparency = 1
}):Play()

TweenService:Create(percent, fadeInfo, {
    TextTransparency = 1
}):Play()

TweenService:Create(barBackground, fadeInfo, {
    BackgroundTransparency = 1
}):Play()

TweenService:Create(bar, fadeInfo, {
    BackgroundTransparency = 1
}):Play()

task.wait(0.8)

gui:Destroy()
