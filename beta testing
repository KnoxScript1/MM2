local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KnoxLoadingUI"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.Parent = player:WaitForChild("PlayerGui")

-- Background
local background = Instance.new("Frame")
background.Size = UDim2.fromScale(1, 1)
background.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
background.BorderSizePixel = 0
background.Parent = gui

-- Gradient background
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 8, 12)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(20, 20, 28)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 8, 12))
})
gradient.Rotation = 0
gradient.Parent = background

-- Animate background gradient
task.spawn(function()
    while gui.Parent do
        local tween = TweenService:Create(
            gradient,
            TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {Rotation = 180}
        )
        tween:Play()
        tween.Completed:Wait()

        gradient.Rotation = 0
    end
end)

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.fromScale(0.8, 0.1)
title.Position = UDim2.fromScale(0.1, 0.30)
title.BackgroundTransparency = 1
title.Text = "KNOX SCRIPT"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = background

-- Title glow
local glow = Instance.new("TextLabel")
glow.Size = title.Size
glow.Position = title.Position
glow.BackgroundTransparency = 1
glow.Text = "KNOX SCRIPT"
glow.TextColor3 = Color3.fromRGB(255, 255, 255)
glow.TextTransparency = 0.7
glow.TextScaled = true
glow.Font = Enum.Font.GothamBold
glow.ZIndex = title.ZIndex - 1
glow.Parent = background

-- Pulsing title
task.spawn(function()
    while gui.Parent do
        TweenService:Create(
            title,
            TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {TextTransparency = 0.25}
        ):Play()

        TweenService:Create(
            glow,
            TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {TextTransparency = 0.45}
        ):Play()

        task.wait(1)

        TweenService:Create(
            title,
            TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {TextTransparency = 0}
        ):Play()

        TweenService:Create(
            glow,
            TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {TextTransparency = 0.7}
        ):Play()

        task.wait(1)
    end
end)

-- Subtitle
local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.fromScale(0.7, 0.05)
subtitle.Position = UDim2.fromScale(0.15, 0.405)
subtitle.BackgroundTransparency = 1
subtitle.Text = "Knox Script Loading Script"
subtitle.TextColor3 = Color3.fromRGB(170, 170, 170)
subtitle.TextScaled = true
subtitle.Font = Enum.Font.Gotham
subtitle.Parent = background

-- Percentage
local percent = Instance.new("TextLabel")
percent.Size = UDim2.fromScale(0.6, 0.06)
percent.Position = UDim2.fromScale(0.2, 0.48)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.TextColor3 = Color3.fromRGB(255, 255, 255)
percent.TextScaled = true
percent.Font = Enum.Font.GothamBold
percent.Parent = background

-- Bar background
local barBackground = Instance.new("Frame")
barBackground.Size = UDim2.fromScale(0.6, 0.025)
barBackground.Position = UDim2.fromScale(0.2, 0.57)
barBackground.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
barBackground.BorderSizePixel = 0
barBackground.Parent = background

local barCorner = Instance.new("UICorner")
barCorner.CornerRadius = UDim.new(1, 0)
barCorner.Parent = barBackground

-- Loading bar
local bar = Instance.new("Frame")
bar.Size = UDim2.fromScale(0, 1)
bar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
bar.BorderSizePixel = 0
bar.Parent = barBackground

local barCorner2 = Instance.new("UICorner")
barCorner2.CornerRadius = UDim.new(1, 0)
barCorner2.Parent = bar

-- Shimmer effect
local shimmer = Instance.new("Frame")
shimmer.Size = UDim2.fromScale(0.15, 2)
shimmer.Position = UDim2.fromScale(-0.2, -0.5)
shimmer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
shimmer.BackgroundTransparency = 0.65
shimmer.BorderSizePixel = 0
shimmer.Rotation = 15
shimmer.Parent = bar

task.spawn(function()
    while gui.Parent do
        shimmer.Position = UDim2.fromScale(-0.2, -0.5)

        local tween = TweenService:Create(
            shimmer,
            TweenInfo.new(1.2, Enum.EasingStyle.Linear),
            {Position = UDim2.fromScale(1.1, -0.5)}
        )

        tween:Play()
        tween.Completed:Wait()

        task.wait(0.3)
    end
end)

-- Floating particles
for i = 1, 25 do
    local particle = Instance.new("Frame")

    particle.Size = UDim2.fromOffset(
        math.random(2, 5),
        math.random(2, 5)
    )

    particle.Position = UDim2.fromScale(
        math.random(),
        math.random()
    )

    particle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    particle.BackgroundTransparency = math.random(50, 85) / 100
    particle.BorderSizePixel = 0
    particle.Parent = background

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = particle

    task.spawn(function()
        while gui.Parent do
            local newPosition = UDim2.fromScale(
                math.random(),
                math.random()
            )

            TweenService:Create(
                particle,
                TweenInfo.new(
                    math.random(3, 7),
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                ),
                {
                    Position = newPosition,
                    BackgroundTransparency = math.random(60, 90) / 100
                }
            ):Play()

            task.wait(math.random(3, 7))
        end
    end)
end

-- Loading: 1% → 70% medium-fast
for i = 1, 70 do
    percent.Text = i .. "%"

    TweenService:Create(
        bar,
        TweenInfo.new(0.045, Enum.EasingStyle.Linear),
        {Size = UDim2.fromScale(i / 100, 1)}
    ):Play()

    task.wait(0.045)
end

-- 71% → 74% transition
for i = 71, 74 do
    percent.Text = i .. "%"

    TweenService:Create(
        bar,
        TweenInfo.new(0.12, Enum.EasingStyle.Linear),
        {Size = UDim2.fromScale(i / 100, 1)}
    ):Play()

    task.wait(0.12)
end

-- 75% → 100% slow
for i = 75, 100 do
    percent.Text = i .. "%"

    TweenService:Create(
        bar,
        TweenInfo.new(0.35, Enum.EasingStyle.Linear),
        {Size = UDim2.fromScale(i / 100, 1)}
    ):Play()

    task.wait(0.35)
end

percent.Text = "100%"
subtitle.Text = "Loaded successfully"

task.wait(0.8)

-- Fade out
local fadeInfo = TweenInfo.new(
    0.8,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
)

for _, object in ipairs(background:GetDescendants()) do
    if object:IsA("TextLabel") then
        TweenService:Create(object, fadeInfo, {
            TextTransparency = 1
        }):Play()
    elseif object:IsA("Frame") then
        TweenService:Create(object, fadeInfo, {
            BackgroundTransparency = 1
        }):Play()
    end
end

TweenService:Create(background, fadeInfo, {
    BackgroundTransparency = 1
}):Play()

task.wait(1)
gui:Destroy()
