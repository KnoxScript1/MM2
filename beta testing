bgGradient.Parent = background

-- Animated background
task.spawn(function()
	while gui.Parent do
		local tween = TweenService:Create(
			bgGradient,
			TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{Rotation = 180}
		)

		tween:Play()
		tween.Completed:Wait()
		bgGradient.Rotation = 0
	end
end)

